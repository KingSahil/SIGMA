SIGMA_HOST=127.0.0.1
SIGMA_PORT=8000
SIGMA_MAX_UPLOAD_BYTES=536870912
SIGMA_MAX_ANALYSIS_SAMPLES=1000000

# Frontend values are also copied to frontend/.env.local for local development.
NEXT_PUBLIC_SIGMA_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SIGMA_WS_URL=ws://127.0.0.1:8000

# Keep this value on the backend only. Never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: defaults to data/sigma_rag.sqlite3
# SIGMA_RAG_DB=data/sigma_rag.sqlite3
