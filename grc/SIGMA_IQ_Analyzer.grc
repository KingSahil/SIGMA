    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: Constellation view; useful for PSK/QAM inspection
    grid: 'True'
    gui_hint: ''
    label1: IQ Samples
