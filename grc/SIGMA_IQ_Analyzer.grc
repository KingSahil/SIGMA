    file: signal.iq
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 420.0]
    rotation: 0
    state: enabled
- name: time_sink
  id: qtgui_time_sink_x
